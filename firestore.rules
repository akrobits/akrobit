rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPortalKey(key) {
      return key is string && key.size() == 64 && key.matches('^[a-f0-9]{64}$');
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'akrobits@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveMember() {
      return isAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
      );
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'active', 'isOnline', 'lastSeenAt', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.role is string && (data.role == 'admin' || data.role == 'employee')
        && data.active is bool
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['email', 'updatedAt'])
        && data.keys().hasOnly(['email', 'updatedAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && isValidId(data.grantedBy);
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'orgId', 'createdBy', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'phone', 'notes', 'portalCode', 'portalKey',
          'portfolioStatus', 'sourceModule', 'moduleId', 'castigadaAt', 'castigadaBy', 'castigadaByName',
          'orgId', 'createdBy', 'active', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 32
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (!('portalCode' in data) || (data.portalCode is string && data.portalCode.size() == 6 && data.portalCode.matches('^[0-9]{6}$')))
        && (!('portalKey' in data) || isValidPortalKey(data.portalKey))
        && (!('portfolioStatus' in data) || (data.portfolioStatus is string && (data.portfolioStatus == 'active' || data.portfolioStatus == 'castigada')))
        && (!('sourceModule' in data) || (data.sourceModule is string && data.sourceModule.size() >= 1 && data.sourceModule.size() <= 60))
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60))
        && (!('castigadaBy' in data) || isValidId(data.castigadaBy))
        && (!('castigadaByName' in data) || (data.castigadaByName is string && data.castigadaByName.size() >= 1 && data.castigadaByName.size() <= 80))
        && data.orgId == 'akrobit'
        && isValidId(data.createdBy)
        && data.active is bool;
    }

    function isValidCredit(data) {
      return data.keys().hasAll([
          'id', 'clientId', 'clientName', 'currency', 'principal',
          'interestRate', 'initialTotal', 'currentBalance', 'status',
          'orgId', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clientId', 'clientName', 'currency', 'principal',
          'interestRate', 'initialTotal', 'currentBalance', 'status',
          'interestMode', 'moduleId', 'lastPaymentAt', 'frozenDays', 'frozenAccruedInterest', 'frozenAt',
          'orgId', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.clientId)
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && data.currency is string && (data.currency == 'NIO' || data.currency == 'USD')
        && data.principal is number && data.principal > 0 && data.principal <= 100000000
        && data.interestRate is number && (
          (('interestMode' in data) && data.interestMode == 'closed' && data.interestRate >= 0 && data.interestRate <= 100) ||
          (data.interestRate >= 5 && data.interestRate <= 10)
        )
        && data.initialTotal is number && data.initialTotal > 0 && data.initialTotal <= 200000000
        && data.currentBalance is number && data.currentBalance >= 0 && data.currentBalance <= 200000000
        && data.status is string && (data.status == 'active' || data.status == 'settled')
        && (!('interestMode' in data) || (data.interestMode is string && (data.interestMode == 'prorated_daily' || data.interestMode == 'pre_added' || data.interestMode == 'closed')))
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60))
        && (!('frozenDays' in data) || (data.frozenDays is number && data.frozenDays >= 0 && data.frozenDays <= 100000))
        && (!('frozenAccruedInterest' in data) || (data.frozenAccruedInterest is number && data.frozenAccruedInterest >= 0 && data.frozenAccruedInterest <= 200000000))
        && data.orgId == 'akrobit'
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
          'id', 'creditId', 'clientId', 'type', 'currency',
          'amount', 'interestRate', 'previousBalance', 'newBalance',
          'orgId', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'creditId', 'clientId', 'type', 'currency',
          'amount', 'interestRate', 'previousBalance', 'newBalance',
          'note', 'paymentMethod', 'moduleId',
          'productId', 'productName', 'quantitySold', 'costAmount',
          'profitType', 'profitValue', 'profitAmount', 'commissionAmount', 'netProfitAmount',
          'orgId', 'createdBy', 'createdByName', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.creditId)
        && isValidId(data.clientId)
        && data.type is string && (data.type == 'credit' || data.type == 'payment' || data.type == 'adjustment' || data.type == 'sale')
        && data.currency is string && (data.currency == 'NIO' || data.currency == 'USD')
        && data.amount is number && data.amount >= 0 && data.amount <= 200000000
        && data.interestRate is number && data.interestRate >= 0 && data.interestRate <= 100
        && data.previousBalance is number && data.previousBalance >= 0 && data.previousBalance <= 200000000
        && data.newBalance is number && data.newBalance >= 0 && data.newBalance <= 200000000
        && (!('note' in data) || (data.note is string && data.note.size() <= 240))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && (data.paymentMethod == 'cash' || data.paymentMethod == 'bank')))
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60))
        && (!('productId' in data) || isValidId(data.productId))
        && (!('productName' in data) || (data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 120))
        && (!('quantitySold' in data) || (data.quantitySold is number && data.quantitySold >= 0 && data.quantitySold <= 100000000))
        && (!('costAmount' in data) || (data.costAmount is number && data.costAmount >= 0 && data.costAmount <= 200000000))
        && (!('profitType' in data) || (data.profitType is string && (data.profitType == 'amount' || data.profitType == 'percent')))
        && (!('profitValue' in data) || (data.profitValue is number && data.profitValue >= 0 && data.profitValue <= 200000000))
        && (!('profitAmount' in data) || (data.profitAmount is number && data.profitAmount >= 0 && data.profitAmount <= 200000000))
        && (!('commissionAmount' in data) || (data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 200000000))
        && (!('netProfitAmount' in data) || (data.netProfitAmount is number && data.netProfitAmount >= -200000000 && data.netProfitAmount <= 200000000))
        && data.orgId == 'akrobit'
        && isValidId(data.createdBy)
        && data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 80;
    }

    function isValidModificationRequest(data) {
      return data.keys().hasAll([
          'id', 'targetType', 'creditId', 'clientId', 'clientName',
          'currency', 'oldValue', 'newValue', 'oldInterestRate', 'newInterestRate',
          'reason', 'status', 'orgId', 'requestedBy', 'requestedByName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'targetType', 'creditId', 'transactionId', 'clientId', 'clientName',
          'currency', 'oldValue', 'newValue', 'oldInterestRate', 'newInterestRate',
          'reason', 'status', 'moduleId', 'orgId', 'requestedBy', 'requestedByName',
          'reviewedBy', 'reviewedByName', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.targetType is string && (data.targetType == 'credit' || data.targetType == 'transaction')
        && isValidId(data.creditId)
        && (!('transactionId' in data) || data.transactionId == '' || isValidId(data.transactionId))
        && isValidId(data.clientId)
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && data.currency is string && (data.currency == 'NIO' || data.currency == 'USD')
        && data.oldValue is number && data.oldValue >= 0 && data.oldValue <= 200000000
        && data.newValue is number && data.newValue >= 0 && data.newValue <= 200000000
        && data.oldInterestRate is number && data.oldInterestRate >= 0 && data.oldInterestRate <= 100
        && data.newInterestRate is number && data.newInterestRate >= 0 && data.newInterestRate <= 100
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 240
        && data.status is string && (
          data.status == 'pending' ||
          data.status == 'approved' ||
          data.status == 'rejected' ||
          data.status == 'corrected'
        )
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60))
        && data.orgId == 'akrobit'
        && isValidId(data.requestedBy)
        && data.requestedByName is string && data.requestedByName.size() >= 1 && data.requestedByName.size() <= 80
        && (!('reviewedBy' in data) || data.reviewedBy == '' || isValidId(data.reviewedBy))
        && (!('reviewedByName' in data) || (data.reviewedByName is string && data.reviewedByName.size() <= 80));
    }

    function isValidClientPortal(data) {
      return data.keys().hasAll([
          'id', 'clientId', 'clientName', 'orgId', 'totalNio', 'totalUsd',
          'activeCredits', 'recentTransactions', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'clientId', 'clientName', 'orgId', 'totalNio', 'totalUsd',
          'activeCredits', 'recentTransactions', 'portfolioStatus', 'moduleId', 'moduleLabel', 'updatedAt'
        ])
        && isValidPortalKey(data.id)
        && isValidId(data.clientId)
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120
        && data.orgId == 'akrobit'
        && data.totalNio is number && data.totalNio >= 0 && data.totalNio <= 400000000
        && data.totalUsd is number && data.totalUsd >= 0 && data.totalUsd <= 400000000
        && (!('portfolioStatus' in data) || (data.portfolioStatus is string && (data.portfolioStatus == 'active' || data.portfolioStatus == 'castigada')))
        && (!('moduleId' in data) || (data.moduleId is string && data.moduleId.size() >= 1 && data.moduleId.size() <= 60))
        && (!('moduleLabel' in data) || (data.moduleLabel is string && data.moduleLabel.size() >= 1 && data.moduleLabel.size() <= 60))
        && data.activeCredits is list && data.activeCredits.size() <= 50
        && (
          data.activeCredits.size() == 0 || (
            data.activeCredits[0] is map &&
            data.activeCredits[0].keys().hasAll(['label', 'currency', 'principal', 'interestRate', 'currentBalance', 'dateLabel']) &&
            data.activeCredits[0].keys().hasOnly(['label', 'currency', 'principal', 'interestRate', 'currentBalance', 'dateLabel', 'lastActivityMs', 'interestMode', 'projected30DayInterest', 'projected30DayTotal', 'isFrozen', 'frozenDays', 'frozenAccruedInterest']) &&
            data.activeCredits[0].label is string && data.activeCredits[0].label.size() <= 60 &&
            data.activeCredits[0].currency is string && (data.activeCredits[0].currency == 'NIO' || data.activeCredits[0].currency == 'USD') &&
            data.activeCredits[0].principal is number &&
            data.activeCredits[0].interestRate is number &&
            data.activeCredits[0].currentBalance is number &&
            data.activeCredits[0].dateLabel is string && data.activeCredits[0].dateLabel.size() <= 60 &&
            (!('lastActivityMs' in data.activeCredits[0]) || data.activeCredits[0].lastActivityMs is number) &&
            (!('interestMode' in data.activeCredits[0]) || (data.activeCredits[0].interestMode is string && (data.activeCredits[0].interestMode == 'prorated_daily' || data.activeCredits[0].interestMode == 'pre_added' || data.activeCredits[0].interestMode == 'closed'))) &&
            (!('projected30DayInterest' in data.activeCredits[0]) || data.activeCredits[0].projected30DayInterest is number) &&
            (!('projected30DayTotal' in data.activeCredits[0]) || data.activeCredits[0].projected30DayTotal is number) &&
            (!('isFrozen' in data.activeCredits[0]) || data.activeCredits[0].isFrozen is bool) &&
            (!('frozenDays' in data.activeCredits[0]) || data.activeCredits[0].frozenDays is number) &&
            (!('frozenAccruedInterest' in data.activeCredits[0]) || data.activeCredits[0].frozenAccruedInterest is number)
          )
        )
        && data.recentTransactions is list && data.recentTransactions.size() <= 100
        && (
          data.recentTransactions.size() == 0 || (
            data.recentTransactions[0] is map &&
            data.recentTransactions[0].keys().hasAll(['type', 'currency', 'amount', 'interestRate', 'previousBalance', 'newBalance', 'dateLabel']) &&
            data.recentTransactions[0].keys().hasOnly(['type', 'currency', 'amount', 'interestRate', 'previousBalance', 'newBalance', 'note', 'paymentMethod', 'productName', 'dateLabel']) &&
            data.recentTransactions[0].type is string && (data.recentTransactions[0].type == 'credit' || data.recentTransactions[0].type == 'payment' || data.recentTransactions[0].type == 'adjustment' || data.recentTransactions[0].type == 'sale') &&
            data.recentTransactions[0].currency is string && (data.recentTransactions[0].currency == 'NIO' || data.recentTransactions[0].currency == 'USD') &&
            data.recentTransactions[0].amount is number &&
            data.recentTransactions[0].interestRate is number &&
            data.recentTransactions[0].previousBalance is number &&
            data.recentTransactions[0].newBalance is number &&
            (!('note' in data.recentTransactions[0]) || (data.recentTransactions[0].note is string && data.recentTransactions[0].note.size() <= 240)) &&
            (!('paymentMethod' in data.recentTransactions[0]) || (data.recentTransactions[0].paymentMethod is string && (data.recentTransactions[0].paymentMethod == 'cash' || data.recentTransactions[0].paymentMethod == 'bank'))) &&
            (!('productName' in data.recentTransactions[0]) || (data.recentTransactions[0].productName is string && data.recentTransactions[0].productName.size() <= 120)) &&
            data.recentTransactions[0].dateLabel is string && data.recentTransactions[0].dateLabel.size() <= 60
          )
        );
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'currency', 'quantity',
          'costPrice', 'salesCommission', 'profitType', 'profitValue',
          'orgId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'barcode', 'category', 'carrier', 'currency', 'quantity',
          'costPrice', 'salesCommission', 'profitType', 'profitValue', 'notes',
          'orgId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('barcode' in data) || (data.barcode is string && data.barcode.size() <= 80))
        && data.category is string && (data.category == 'recharge' || data.category == 'general')
        && (!('carrier' in data) || (data.carrier is string && (data.carrier == 'claro' || data.carrier == 'tigo' || data.carrier == 'none')))
        && data.currency is string && (data.currency == 'NIO' || data.currency == 'USD')
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 100000000
        && data.costPrice is number && data.costPrice >= 0 && data.costPrice <= 100000000
        && data.salesCommission is number && data.salesCommission >= 0 && data.salesCommission <= 100000000
        && data.profitType is string && (data.profitType == 'amount' || data.profitType == 'percent')
        && data.profitValue is number && data.profitValue >= 0 && data.profitValue <= 100000000
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.orgId == 'akrobit'
        && isValidId(data.createdBy);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isValidUserProfile(incoming())
        && isOwner(userId)
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().active == true) ||
          (incoming().role == 'employee' && incoming().active == false)
        );
      allow update: if isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().active == existing().active
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'isOnline', 'lastSeenAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && isOwner(userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && (isOwner(userId) || isAdmin())
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId)
        && isValidAdminRecord(incoming())
        && isAdmin()
        && incoming().uid == userId
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isBootstrappedAdmin();
    }

    match /clients/{clientId} {
      allow get: if isValidId(clientId) && isActiveMember();
      allow list: if isActiveMember() && existing().orgId == 'akrobit';
      allow create: if isValidId(clientId)
        && isValidClient(incoming())
        && isActiveMember()
        && incoming().id == clientId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('portfolioStatus' in incoming()) || incoming().portfolioStatus == 'active' || isAdmin());
      allow update: if isValidId(clientId)
        && isValidClient(incoming())
        && isActiveMember()
        && incoming().id == existing().id
        && incoming().orgId == existing().orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'notes', 'active', 'portalCode', 'portalKey', 'updatedAt'])
        );
      allow delete: if isValidId(clientId) && isAdmin();
    }

    match /credits/{creditId} {
      allow get: if isValidId(creditId) && isActiveMember();
      allow list: if isActiveMember() && existing().orgId == 'akrobit';
      allow create: if isValidId(creditId)
        && isValidCredit(incoming())
        && isActiveMember()
        && incoming().id == creditId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (!('frozenAt' in incoming()) && !('frozenDays' in incoming()) && !('frozenAccruedInterest' in incoming())))
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId));
      allow update: if isValidId(creditId)
        && isValidCredit(incoming())
        && isActiveMember()
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().orgId == existing().orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdByName == existing().createdByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().status != 'settled'
            && incoming().principal == existing().principal
            && incoming().interestRate == existing().interestRate
            && incoming().initialTotal == existing().initialTotal
            && incoming().currency == existing().currency
            && (!('frozenAccruedInterest' in incoming()) || incoming().frozenAccruedInterest == 0 || ('frozenAccruedInterest' in existing() && incoming().frozenAccruedInterest == existing().frozenAccruedInterest))
            && incoming().diff(existing()).affectedKeys().hasOnly(['currentBalance', 'status', 'lastPaymentAt', 'frozenAccruedInterest', 'updatedAt'])
          ) ||
          (
            existing().status != 'settled'
            && ('interestMode' in existing())
            && existing().interestMode == 'closed'
            && incoming().interestMode == 'closed'
            && incoming().currency == existing().currency
            && incoming().diff(existing()).affectedKeys().hasOnly(['principal', 'initialTotal', 'currentBalance', 'status', 'lastPaymentAt', 'updatedAt'])
          )
        );
      allow delete: if isValidId(creditId) && isAdmin();
    }

    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isActiveMember();
      allow list: if isActiveMember() && existing().orgId == 'akrobit';
      allow create: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && isActiveMember()
        && incoming().id == transactionId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId))
        && (
          exists(/databases/$(database)/documents/credits/$(incoming().creditId)) ||
          existsAfter(/databases/$(database)/documents/credits/$(incoming().creditId))
        );
      allow update: if isValidId(transactionId)
        && isValidTransaction(incoming())
        && isAdmin()
        && incoming().id == existing().id
        && incoming().creditId == existing().creditId
        && incoming().clientId == existing().clientId
        && incoming().orgId == existing().orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(transactionId) && isAdmin();
    }

    match /modificationRequests/{requestId} {
      allow get: if isValidId(requestId) && isActiveMember();
      allow list: if isActiveMember() && (isAdmin() || existing().requestedBy == request.auth.uid);
      allow create: if isValidId(requestId)
        && isValidModificationRequest(incoming())
        && isActiveMember()
        && incoming().id == requestId
        && incoming().status == 'pending'
        && incoming().requestedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/credits/$(incoming().creditId))
        && exists(/databases/$(database)/documents/clients/$(incoming().clientId));
      allow update: if isValidId(requestId)
        && isValidModificationRequest(incoming())
        && isAdmin()
        && existing().status == 'pending'
        && incoming().id == existing().id
        && incoming().creditId == existing().creditId
        && incoming().clientId == existing().clientId
        && incoming().orgId == existing().orgId
        && incoming().requestedBy == existing().requestedBy
        && incoming().requestedByName == existing().requestedByName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'newValue', 'newInterestRate', 'reviewedBy', 'reviewedByName', 'updatedAt'
        ]);
      allow delete: if isValidId(requestId) && isAdmin();
    }

    match /clientPortals/{portalKey} {
      allow get: if isValidPortalKey(portalKey);
      allow list: if false;
      allow create: if isValidPortalKey(portalKey)
        && isValidClientPortal(incoming())
        && isActiveMember()
        && incoming().id == portalKey
        && incoming().updatedAt == request.time
        && (
          exists(/databases/$(database)/documents/clients/$(incoming().clientId)) ||
          existsAfter(/databases/$(database)/documents/clients/$(incoming().clientId))
        );
      allow update: if isValidPortalKey(portalKey)
        && isValidClientPortal(incoming())
        && isActiveMember()
        && incoming().id == existing().id
        && incoming().clientId == existing().clientId
        && incoming().orgId == existing().orgId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'clientName', 'totalNio', 'totalUsd', 'activeCredits', 'recentTransactions', 'portfolioStatus', 'moduleId', 'moduleLabel', 'updatedAt'
        ]);
      allow delete: if isValidPortalKey(portalKey) && isActiveMember();
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && isActiveMember();
      allow list: if isActiveMember() && existing().orgId == 'akrobit';
      allow create: if isValidId(productId)
        && isValidProduct(incoming())
        && isActiveMember()
        && incoming().id == productId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && isActiveMember()
        && incoming().id == existing().id
        && incoming().orgId == existing().orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt'])
        );
      allow delete: if isValidId(productId) && isAdmin();
    }
  }
}
